# Copy to scripts/sign.local.env (git-ignored) and fill in, or export the same variables in your shell.
# Without any of them, scripts/build_dmg.sh makes an ad-hoc signature (runs on the Mac that built it only).
#
# MSE_SIGN_IDENTITY  Keychain identity name, e.g. "Developer ID Application: Your Name (TEAMID)". "-" is ad-hoc.
# MSE_SIGN_SHA1      the certificate's SHA-1 fingerprint: security find-identity -v -p codesigning
# MSE_TEAM_ID        your Apple Team ID (optional; when set, the signed app must report it)
MSE_SIGN_IDENTITY="-"
MSE_SIGN_SHA1=""
MSE_TEAM_ID=""
